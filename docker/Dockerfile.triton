# Triton JIT compilation does not require nvcc; the smaller runtime image keeps
# the first WSL/Docker setup substantially lighter than the CUDA devel image.
FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv git \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --break-system-packages --index-url https://download.pytorch.org/whl/cu128 torch==2.11.0 \
    && python3 -m pip install --break-system-packages triton

WORKDIR /workspace
CMD ["bash"]
